    return sp.Poly(sp.expand(expr.subs(Cc**2, u).subs(Cc, sp.sqrt(u))), u)


T_int, T_ext = R(5, 16), R(7, 16)
for tt in (T_int, T_ext):
    g, gp, AA = g_poly(tt)
