CIRC = list(zip(sx, cx)) + list(zip(sy, cy)) + [(sw, cw)]


def zero_on_circle(expr):
    num, _ = sp.fraction(sp.cancel(sp.together(expr)))
    num = sp.expand(num)
    for sv, cv in CIRC:
        num = sp.rem(num, sv**2 + cv**2 - 1, sv)
    return sp.expand(num) == 0


