        fpv = -Sg * gpv                                   # f'(k) = -sin k g'(cos k)
        zc = CI(C, -Sg) * CI(RI(2) * gv * gv - 1, RI(-4) * gv * fpv)
        zcs.append(((sC, sS), zc))
