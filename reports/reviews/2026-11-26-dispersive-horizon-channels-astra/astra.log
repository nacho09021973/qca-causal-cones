Ss = sg_star[1] * sp.sqrt(1 - ustar)
gS = 4 * A_int * Cs**3 + (1 - 4 * A_int) * Cs
gpS = 12 * A_int * Cs**2 + 1 - 4 * A_int
zc_exact = sp.expand((Cs - I * Ss) * (2 * gS**2 - 1 + 4 * I * gS * Ss * gpS))
Xm = sp.symbols('X')
