zero('T2 solution is linear homogeneous in Y_x', Ynext - M_ind * Yx)
M_rep = M_report(c, s, cP, sP, z)
names = 'PQRH'
for bi, (r0, c0) in enumerate([(0, 0), (0, 6), (6, 0), (6, 6)]):
    blk = M_ind[r0:r0 + 6, c0:c0 + 6] - M_rep[r0:r0 + 6, c0:c0 + 6]
