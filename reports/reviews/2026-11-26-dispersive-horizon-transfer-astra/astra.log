#   a_{j+1}(x+1) = c_j(x) a_j(x) - s_j(x) b_j(x)
#   b_{j+1}(x-1) = s_j(x) a_j(x) + c_j(x) b_j(x)
eqs = []
for j in range(1, 6):
    eqs.append(a1[j] - (c[j] * a0[j - 1] - s[j] * b0[j - 1]))
    eqs.append(bm[j] - (s[j] * a0[j - 1] + c[j] * b0[j - 1]))
